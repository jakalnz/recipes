rules_version = '2';
// Shared by two apps in project shop-bf13d:
//   Shop     – root collections (items, stores, trips, presence, meta, photos, ...)
//   Recipes  – collections whose names start with "rx"
// Who may use what lives in the document access/family (no emails in this file):
//   { shop:    ["a@x.com", ...],          // the Shop household (also recipe admins)
//     members: { "a@x.com": "hh1", ... } } // every family member -> household id
// access/family can only be written by a Shop account (or the console / Admin SDK).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function access()   { return get(/databases/$(database)/documents/access/family).data; }
    function shopUser() { return signedIn() && request.auth.token.email in access().shop; }
    function family()   { return signedIn() && (request.auth.token.email in access().members || shopUser()); }
    function hid()      { return access().members.get(request.auth.token.email, ''); }
    function isRx(c)    { return c.matches('rx.*'); }

    // ---- Shop: unchanged behaviour for the Shop household, nothing for anyone else ----
    match /{col}/{document=**} {
      allow read, write: if shopUser() && !isRx(col) && col != 'access';
    }

    // ---- access list ----
    match /access/family {
      allow read: if family();
      allow write: if shopUser();
    }

    // ---- Recipes ----
    match /rxMembers/{uid} {
      allow read: if family();
      allow write: if family() && request.auth.uid == uid;
    }
    // Dietary profiles: one per person (with or without an account), managed by their household.
    match /rxPeople/{id} {
      allow read: if family();
      allow create: if family() && (request.resource.data.household == hid() || shopUser());
      allow update: if family() && (resource.data.household == hid() || shopUser())
                    && (request.resource.data.household == resource.data.household || shopUser());
      allow delete: if family() && (resource.data.household == hid() || shopUser());
    }
    match /rxHouseholds/{h} {
      allow read: if family();
      allow write: if family() && (hid() == h || shopUser());
    }
    match /rxRecipes/{id} {
      allow read: if family();
      allow create: if family() && request.resource.data.createdBy.uid == request.auth.uid;
      allow update: if family() && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if family() && (resource.data.createdBy.uid == request.auth.uid || shopUser());
      match /ratings/{uid} {
        allow read: if family();
        allow write: if family() && request.auth.uid == uid;
      }
    }
    // One photo per recipe, as a data URL (kept out of the recipe doc so lists stay small).
    match /rxPhotos/{id} {
      allow read, delete: if family();
      allow write: if family() && request.resource.data.data is string
                    && request.resource.data.data.size() < 1000000;
    }
    // Food composition table for nutrition (NZ FOODfiles / AFCD / USDA). Family can read; only Shop accounts load it.
    match /rxFoods/{part} {
      allow read: if family();
      allow write: if shopUser();
    }
    match /rxPlans/{h}/{document=**} {
      allow read, write: if family() && hid() == h;
    }
    match /rxFamilyMeals/{id} {
      allow read, create, update: if family();
      allow delete: if family() && (resource.data.host == hid() || shopUser());
    }
    match /rxUsage/{uid} {
      allow read: if family() && request.auth.uid == uid;   // written only by Cloud Functions
    }
  }
}
